# Copy this file to `.env` and fill in the values from your EmailJS dashboard.
# `.env` is gitignored. On Netlify, set the same three under Site settings →
# Environment variables.
#
# Also set the allowed-origins list in EmailJS → Account → Security, or the
# public key can be used from any site.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
